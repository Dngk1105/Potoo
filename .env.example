# Environment variables for Phô tô bút. Names only; never commit values.
# Local: copy to .env.local and fill in. Staging and main: values live in Vercel and GitHub Actions.
# Only public URLs and public keys may use the NEXT_PUBLIC_ prefix (they ship to the browser).
# See docs/design/environments.md, section 5.

# Supabase. Local values: `npx supabase status` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (Route Handlers, cleanup job). Bypasses RLS.
SUPABASE_SECRET_KEY=

# LiveKit. Local: `npm run livekit`, then ws://localhost:7880 with key devkey / secret secret.
NEXT_PUBLIC_LIVEKIT_URL=
# Server only (Route Handlers issue room tokens).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Hours to keep shots after a session ends. Local 5, staging and main 24.
SHOT_RETENTION_HOURS=

# Local only (read by the Supabase CLI from this same file). Leave empty on Vercel.
# Google OAuth client "potoo-dev"; ask Dũng privately for the values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Set to false on Windows to skip the vector/analytics containers.
SUPABASE_ANALYTICS_ENABLED=